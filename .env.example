# Copy this file to .env and fill it in.

# Local development (npm run db:local):
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/disruptioniq"
# Neon (for Vercel): paste the pooled connection string from the Neon dashboard instead, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Shared secret a carrier must send in the x-webhook-secret header.
WEBHOOK_SECRET="change-me"
